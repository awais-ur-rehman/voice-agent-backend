          "type": "string"
        },
        "segment_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Segment Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "session_id",
        "generation",
        "sequence",
        "kind",
        "segment_id"
      ],
      "title": "SegmentEndMessage",
      "type": "object"
    },
    "SegmentMessage": {
      "additionalProperties": false,
      "properties": {
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "kind": {
          "const": "segment",
          "title": "Kind",
          "type": "string"
        },
        "sample_rate": {
          "maximum": 48000,
          "minimum": 16000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "segment_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Segment Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "total_samples": {
          "maximum": 4800000,
          "minimum": 1,
          "title": "Total Samples",
          "type": "integer"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        }
