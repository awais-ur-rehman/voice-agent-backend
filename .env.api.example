# Generate local credentials with: python3 scripts/dev_setup.py
# This example contains placeholders; do not use it as a working env file.
DEV_ADMIN_PASSWORD=replace_with_random_local_admin_password
DEV_APP_PASSWORD=replace_with_random_local_app_password
SCHEDULER_JWT_SECRET=replace_with_random_secret_at_least_32_characters
SCHEDULER_DATABASE_URL=postgresql+psycopg://scheduler_app:replace_with_random_local_app_password@127.0.0.1:55432/voice_agent
SCHEDULER_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:replace_with_random_local_admin_password@127.0.0.1:55432/voice_agent

# Add missing brain keys without changing saved credentials:
# python3 scripts/dev_setup.py --enable-brain
DEV_VALKEY_PASSWORD=replace_with_random_local_valkey_password
SCHEDULER_RUNTIME_SECRET=replace_with_separate_random_secret_at_least_32_characters
SCHEDULER_VALKEY_URL=valkey://:replace_with_random_local_valkey_password@127.0.0.1:56380/0

# Generate separate private media keys without overwriting saved values:
# python3 scripts/dev_setup.py --enable-voice
# Enable only after the native worker passes its real model capability checks.
SCHEDULER_VOICE_ENABLED=false
SCHEDULER_VOICE_BOOTSTRAP_SECRET=replace_with_distinct_random_secret_at_least_32_characters
SCHEDULER_VOICE_WORKER_SECRET=replace_with_distinct_random_secret_at_least_32_characters
SCHEDULER_LIVEKIT_API_KEY=replace_with_random_local_key_id
SCHEDULER_LIVEKIT_API_SECRET=replace_with_distinct_random_secret_at_least_32_characters
SCHEDULER_LIVEKIT_URL=ws://127.0.0.1:7880
SCHEDULER_LIVEKIT_API_URL=http://127.0.0.1:7880

# Explicitly enable only for local clinic registration QA.
SCHEDULER_REGISTRATION_ENABLED=false

# Source management is independent of verified worker/model readiness; default disabled.
SCHEDULER_KNOWLEDGE_ENABLED=false
# Native API only; Compose uses its private named volume at /var/lib/knowledge.
SCHEDULER_KNOWLEDGE_BLOB_ROOT=.local/knowledge-blobs
# Optional only when explicitly provisioning the dedicated ingestion login:
# SCHEDULER_KNOWLEDGE_WORKER_PASSWORD=replace_with_distinct_random_worker_password

# Private query RPC; never use the blob ownership key as this bearer credential.
SCHEDULER_KNOWLEDGE_EMBEDDING_URL=http://127.0.0.1:8001
# SCHEDULER_KNOWLEDGE_EMBEDDING_SECRET=replace_with_embedding_service_secret
# SCHEDULER_KNOWLEDGE_BLOB_SECRET=replace_with_distinct_private_blob_and_heartbeat_key

# Optional hosted structured planner. No credentials are loaded unless configured.
# SCHEDULER_LLM_API_KEY=replace_with_provider_key
SCHEDULER_LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
SCHEDULER_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
SCHEDULER_LLM_TIMEOUT_SECONDS=3
SCHEDULER_LLM_REQUEST_BUDGET=100
# Operator pacing, NOT a measured NVIDIA quota. Shared by endpoint/key across models.
SCHEDULER_LLM_ENDPOINT_RPM=10
SCHEDULER_LLM_ENDPOINT_BURST=1
SCHEDULER_LLM_MAX_OUTSTANDING=4
# Secondary is absent unless all three independent settings are supplied.
# SCHEDULER_LLM_SECONDARY_BASE_URL=https://provider.example/v1
# SCHEDULER_LLM_SECONDARY_MODEL=operator-selected-model
# SCHEDULER_LLM_SECONDARY_API_KEY=replace_with_secondary_provider_key
# Optional USD-per-million rates; omitted rates or token counts mean unknown cost.
# SCHEDULER_LLM_INPUT_RATE_USD_PER_MILLION=0
# SCHEDULER_LLM_OUTPUT_RATE_USD_PER_MILLION=0
# SCHEDULER_LLM_SECONDARY_INPUT_RATE_USD_PER_MILLION=0
# SCHEDULER_LLM_SECONDARY_OUTPUT_RATE_USD_PER_MILLION=0

# Rolling shutdown: deny new sessions while existing cleanup/replays remain usable.
SCHEDULER_DRAIN_MODE=false
SCHEDULER_SHUTDOWN_DRAIN_SECONDS=3
