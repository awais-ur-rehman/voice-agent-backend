    "VoiceCreate": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "format": "uuid",
          "title": "Agent Id",
          "type": "string"
        },
        "request_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Key",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "request_key"
      ],
      "title": "VoiceCreate",
      "type": "object"
    },
    "VoiceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "call_deadline": {
          "format": "date-time",
          "title": "Call Deadline",
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaGrant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "provisioning",
            "active",
            "disconnected",
            "ended",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "status",
        "generation",
        "revision",
        "call_deadline"
      ],
      "title": "VoiceSnapshot",
      "type": "object"
    },
    "VoiceStateMessage": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "kind": {
          "const": "state",
          "title": "Kind",
          "type": "string"
        },
        "sequence": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "listening",
            "thinking",
            "speaking",
            "error"
          ],
          "title": "State",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "session_id",
        "generation",
        "sequence",
        "kind",
        "state"
      ],
      "title": "VoiceStateMessage",
      "type": "object"
    }
