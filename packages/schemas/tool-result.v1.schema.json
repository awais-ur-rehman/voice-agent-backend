{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent.invalid/schemas/tool-result.v1.schema.json",
  "title": "Proposed v1 tool result envelope",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "say": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ur": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "ur"
      ],
      "additionalProperties": false
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "validation_error",
                "not_verified",
                "verification_failed",
                "patient_not_found",
                "slot_unavailable",
                "outside_policy",
                "not_owner",
                "rate_limited",
                "upstream_timeout",
                "no_answer"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "field": {
              "type": "string"
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "code",
            "retryable"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "ok",
    "data",
    "say",
    "error"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "validation_error",
                  "not_verified",
                  "verification_failed",
                  "patient_not_found",
                  "slot_unavailable",
                  "outside_policy",
                  "not_owner",
                  "rate_limited",
                  "upstream_timeout",
                  "no_answer"
                ]
              },
              "retryable": {
                "type": "boolean"
              },
              "field": {
                "type": "string"
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "code",
              "retryable"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
