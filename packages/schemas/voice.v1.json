      "required": [
        "url",
        "room",
        "participant",
        "token",
        "expires_at",
        "session_id",
        "generation"
      ],
      "title": "MediaGrant",
      "type": "object"
    },
    "PlaybackAck": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "played_samples": {
          "maximum": 4800000,
          "minimum": 0,
          "title": "Played Samples",
          "type": "integer"
        },
        "segment_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Segment Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "session_id",
        "generation",
        "sequence",
        "segment_id",
        "played_samples"
      ],
      "title": "PlaybackAck",
      "type": "object"
    },
    "SegmentEndMessage": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
