{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent.invalid/schemas/tool-result.v1.schema.json",
  "title": "Proposed v1 tool result envelope",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "say": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ur": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "ur"
      ],
      "additionalProperties": false
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "validation_error",
                "not_verified",
                "verification_failed",
                "patient_not_found",
                "slot_unavailable",
                "outside_policy",
                "not_owner",
                "rate_limited",
                "upstream_timeout",
                "no_answer"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "field": {
              "type": "string"
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "code",
            "retryable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "knowledge": {
      "$ref": "#/$defs/KnowledgeTrace"
    }
  },
  "required": [
    "ok",
    "data",
    "say",
    "error"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "validation_error",
                  "not_verified",
                  "verification_failed",
                  "patient_not_found",
                  "slot_unavailable",
                  "outside_policy",
                  "not_owner",
                  "rate_limited",
                  "upstream_timeout",
                  "no_answer"
                ]
              },
              "retryable": {
                "type": "boolean"
              },
              "field": {
                "type": "string"
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "code",
              "retryable"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$defs": {
    "KnowledgeCitation": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "source_name": {
          "maxLength": 200,
          "title": "Source Name",
          "type": "string"
        },
        "chunk_id": {
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "heading": {
          "maxLength": 200,
          "title": "Heading",
          "type": "string"
        },
        "language": {
          "maxLength": 16,
          "title": "Language",
          "type": "string"
        },
        "cosine": {
          "maximum": 1.000001,
          "minimum": 0.55,
          "title": "Cosine",
          "type": "number"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_name",
        "chunk_id",
        "heading",
        "language",
        "cosine",
        "quote"
      ],
      "title": "KnowledgeCitation",
      "type": "object"
    },
    "KnowledgeTrace": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "no_sources",
            "processing_pending",
            "below_threshold",
            "service_unavailable",
            "rejected",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/KnowledgeCitation"
          },
          "maxItems": 4,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "KnowledgeTrace",
      "type": "object"
    }
  }
}
