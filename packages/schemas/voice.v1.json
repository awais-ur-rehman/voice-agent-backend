          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "participant": {
          "title": "Participant",
          "type": "string"
        },
        "room": {
          "title": "Room",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "token": {
          "title": "Token",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
