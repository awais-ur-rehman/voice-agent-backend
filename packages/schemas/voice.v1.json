    "CallControl": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "mute",
            "unmute",
            "end"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sequence": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "session_id",
        "generation",
        "sequence",
        "kind"
      ],
      "title": "CallControl",
      "type": "object"
    },
    "CaptionMessage": {
      "additionalProperties": false,
      "properties": {
