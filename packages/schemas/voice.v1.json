          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "kind": {
          "const": "caption",
          "title": "Kind",
          "type": "string"
        },
        "lang": {
          "enum": [
            "en",
            "ur"
          ],
          "title": "Lang",
          "type": "string"
        },
        "sequence": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "title": "Text",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "session_id",
        "generation",
        "sequence",
        "kind",
        "text",
        "lang"
